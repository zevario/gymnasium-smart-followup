# Salin menjadi ai/.env lalu isi. File .env tidak boleh di-commit.
# Kunci Google Gemini untuk draft pesan (buat di https://aistudio.google.com/apikey).
# Kosong = draft selalu memakai template.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Batas waktu Gemini (detik); harus di bawah DRAFT_TIMEOUT_MS backend (15 detik).
GEMINI_TIMEOUT=12
