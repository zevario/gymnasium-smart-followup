NODE_ENV=development
PORT=3000

FRONTEND_URL=http://localhost:5173,http://localhost:5174

PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_database_password
PGDATABASE=gymnasyum_db

JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_another_long_random_secret

ADMIN_NAME=Gymnasyum Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password

SPV_NAME=Supervisor Gymnasium
SPV_EMAIL=spv@gymnasium.com
SPV_PASSWORD=GantiDenganPasswordMinimal12Karakter
# App React frontend + API pilot (satu lokasi Bintaro)
PILOT_HOST=127.0.0.1
PILOT_PORT=3001
# Optional Ollama endpoint and installed model for controlled drafting
PILOT_AI_URL=
PILOT_AI_MODEL=

# Production: set NODE_ENV=production, HTTPS FRONTEND_URL and two distinct random
# JWT secrets of at least 32 characters. Never use the placeholder values above.
# Optional: comma-separated trusted proxy IP addresses/subnets, matched to your hosting setup.
# Leave empty for direct access; never set a blanket trust-all value.
TRUST_PROXY=
