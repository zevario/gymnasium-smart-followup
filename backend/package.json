{
  "name": "gymnasyum-backend",
  "version": "1.0.0",
  "description": "Backend API for Gymnasyum Smart Reminder & Follow-up",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.js",
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "migrate": "node-pg-migrate",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "seed:admin": "node src/database/seeds/create-admin.js",
    "seed:demo": "node src/database/seeds/seed-demo-data.js",
    "pilot": "node src/pilot-server.js",
    "test:pilot": "node --test test/pilot*.test.js",
    "seed:spv": "node src/database/seeds/create-spv.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "8.7.3",
    "helmet": "^8.3.0",
    "joi": "^18.3.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "nodemon": "^3.1.14"
  },
