NODE_ENV=development
PORT=3000

FRONTEND_URL=http://localhost:5173,http://localhost:5174

PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_database_password
PGDATABASE=gymnasyum_db

JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_another_long_random_secret

ADMIN_NAME=Gymnasyum Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password

SPV_NAME=Supervisor Gymnasium
SPV_EMAIL=spv@gymnasium.com
SPV_PASSWORD=GantiDenganPasswordMinimal12Karakter
# App React frontend + API pilot (satu lokasi Bintaro)
PILOT_HOST=127.0.0.1
PILOT_PORT=3001
# Optional Ollama endpoint and installed model for controlled drafting
PILOT_AI_URL=
PILOT_AI_MODEL=

# Production: set NODE_ENV=production, HTTPS FRONTEND_URL and two distinct random
# JWT secrets of at least 32 characters. Never use the placeholder values above.
# Optional: comma-separated trusted proxy IP addresses/subnets, matched to your hosting setup.
# Leave empty for direct access; never set a blanket trust-all value.
TRUST_PROXY=

# Email akun. Contoh lokal untuk Mailpit, dengan kotak masuk di 127.0.0.1:8025.
# Untuk pengiriman publik, gunakan domain aplikasi HTTPS, pengirim terverifikasi
# serta host dan kredensial SMTP penyedia. Port 587 menggunakan STARTTLS, 465 TLS.
APP_PUBLIC_URL=http://127.0.0.1:3001
MAIL_FROM=Gymnasyum <id.arifibrahim@gmail.com>
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# Inference API klasifikasi prioritas follow-up (PRD v3). Kosong berarti
# aplikasi memakai aturan baseline dan menandai sumbernya sebagai baseline.
INFERENCE_API_URL=
INFERENCE_TIMEOUT_MS=2000

# Layanan lokal: npm run ml:prepare, lalu npm run ml:serve.
# Gunakan INFERENCE_API_URL=http://127.0.0.1:8001 untuk menghubungkan backend.
INFERENCE_PORT=8001
